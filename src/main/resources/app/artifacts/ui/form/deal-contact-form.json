  "definition": {
    "components": [
      {
        "key": "is_legacy_contacts",
        "refreshOn": [
          "counterpartyContacts"
        ],
        "calculateValue": "const contacts = _.get(data, 'contacts', []);\n\nlet legacyContactsExists = false;\n\nconst contactIsNotEmpty = (contact) => {\n    return !!contact.contactFio ||\n        !!contact.contactDepartment ||\n        !!contact.contactEmail ||\n        !!contact.contactPhone ||\n        !!contact.contactPosition ||\n        !!contact.contactComment;\n}\n\nfor (const contact of contacts) {\n    if (contactIsNotEmpty(contact)) {\n        legacyContactsExists = true;\n        break;\n    }\n}\n\nvalue = legacyContactsExists;\n\n// The counterparty contacts arrive asynchronously. Until that request resolves the form knows\n// nothing about them, so the placeholder has to stay hidden - otherwise every deal whose\n// contacts live on the counterparty claims \"there are no contacts\" for the first seconds.\nconst counterpartyLoaded = !_.isUndefined(_.get(data, 'asyncCounterparty'));\nconst noContactsAtAll = !_.get(data, 'contacts.length') && !_.get(data, 'asyncCounterparty.contacts.length');\n\nconst placeholderElement = document.querySelector('.citeck-contacts-widget_placeholder');\nif (placeholderElement) {\n  const htmlPlaceholder = placeholderElement.parentElement;\n\n  if (htmlPlaceholder) {\n    if (counterpartyLoaded && noContactsAtAll) {\n      htmlPlaceholder.removeAttribute('hidden');\n      htmlPlaceholder.removeAttribute('style');\n    } else {\n      htmlPlaceholder.setAttribute('hidden', true);\n    }\n  }\n}\n\n// Each contact list marks its first card as the one to open. Several lists can be rendered at\n// once (own contacts plus the ones coming from the counterparty), and hidden lists keep their\n// markup - so walk the lists, not a flat query over the whole document.\nconst contactGrids = document.querySelectorAll('.citeck-widget-contacts .formio-component-datagrid');\nfor (let g = 0; g < contactGrids.length; g++) {\n  const grid = contactGrids[g];\n\n  if (grid.hasAttribute('hidden') || grid.closest('[hidden]')) {\n    continue;\n  }\n\n  const cards = grid.querySelectorAll('.citeck-widget-contacts__not-collapsed');\n  for (let i = 0; i < cards.length; i++) {\n    const card = cards[i];\n\n    if (card.closest('[hidden]')) {\n      continue;\n    }\n\n    const cardBody = card.querySelector('.panel-body');\n    if (!cardBody) {\n      continue;\n    }\n\n    cardBody.removeAttribute('hidden');\n    cardBody.removeAttribute('style');\n\n    const iconElement = card.querySelector('.citeck-panel-icon-chevron');\n    if (iconElement) {\n      iconElement.className = \"citeck-panel-icon-chevron down\";\n    }\n\n    break;\n  }\n}",
        "optionalWhenDisabled": false,
        "type": "hidden",
        "input": true,
        "reorder": false
      },
      {
        "label": {
          "ru": "Panel"
        },
        "key": "panel_counterparty_contacts",
        "customClass": "citeck-widget-contacts",
        "scrollableContent": true,
        "refreshOn": [
          "is_legacy_contacts"
        ],
        "optionalWhenDisabled": false,
        "type": "panel",
        "input": false,
        "components": [
          {
            "label": "Async Counterparty",
