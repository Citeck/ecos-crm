            "input": true,
            "triggerEventOnChange": false
          },
          {
            "label": {
              "ru": "HTML",
              "en": "HTML"
            },
            "key": "htmlStyles",
            "hidden": true,
            "className": "",
            "content": {
              "ru": "text\n\n<style>\n    .citeck-widget-contacts .form-group {\n        margin: 0;\n    }\n\n    /* The platform sets a border and 0.65rem/0.5rem padding on every datagrid cell. Here each\n       cell holds a whole contact card, so the cell must not add any frame of its own. The\n       selector has to stay inside .citeck-widget-contacts and outrank\n       `.formio-component-datagrid table.table-bordered td`, otherwise it either leaks onto\n       every table of the page or loses and does nothing. */\n    .citeck-widget-contacts .formio-component-datagrid table.table-bordered th,\n    .citeck-widget-contacts .formio-component-datagrid table.table-bordered td {\n        padding: 0;\n        border: none;\n        height: auto;\n    }\n\n    /* Direct child, not descendant: a contact card sits inside a wrapper panel, so a descendant\n       selector applied this inset twice and squeezed the content into the middle of the widget.\n       The card adds no inset of its own, so the fields line up with the neighbouring\n       dashlets, which rely on the dashlet padding alone. */\n    .citeck-widget-contacts .card > .card-body.panel-body {\n        padding: 0 !important;\n        margin-bottom: 12px;\n    }\n\n    .citeck-widget-contacts-comment_view-mode,\n    .citeck-widget-contacts-columns dl {\n        border-bottom: none !important;\n        padding: 5px 0 !important;\n    }\n\n    .citeck-widget-contacts-comment_view-mode dd,\n    .citeck-widget-contacts-columns dd {\n        color: #444444;\n        font-weight: 600;\n    }\n\n    .citeck-widget-contacts-comment_view-mode dt,\n    .citeck-widget-contacts-columns dt {\n        color: #B7B7B7;\n    }\n    .citeck-widget-contacts-comment_view-mode dt:after,\n    .citeck-widget-contacts-columns dt:after {\n        content: \":\";\n    }\n\n    /* Keep the platform's title chip (`.formio-form .card .card-title`) - with several contacts\n       in one widget it is the only thing separating one card from the next. Only the vertical\n       rhythm and the icon alignment are adjusted here. */\n    .citeck-widget-contacts .card .card-title {\n        margin-top: 2px;\n        margin-bottom: 12px !important;\n        margin-left: 0;\n        font-size: 14px !important;\n\n        display: flex;\n        gap: 3px;\n        align-items: center;\n    }\n</style>",
              "en": "text\n\n<style>\n    .citeck-widget-contacts .form-group {\n        margin: 0;\n    }\n\n    /* The platform sets a border and 0.65rem/0.5rem padding on every datagrid cell. Here each\n       cell holds a whole contact card, so the cell must not add any frame of its own. The\n       selector has to stay inside .citeck-widget-contacts and outrank\n       `.formio-component-datagrid table.table-bordered td`, otherwise it either leaks onto\n       every table of the page or loses and does nothing. */\n    .citeck-widget-contacts .formio-component-datagrid table.table-bordered th,\n    .citeck-widget-contacts .formio-component-datagrid table.table-bordered td {\n        padding: 0;\n        border: none;\n        height: auto;\n    }\n\n    /* Direct child, not descendant: a contact card sits inside a wrapper panel, so a descendant\n       selector applied this inset twice and squeezed the content into the middle of the widget.\n       The card adds no inset of its own, so the fields line up with the neighbouring\n       dashlets, which rely on the dashlet padding alone. */\n    .citeck-widget-contacts .card > .card-body.panel-body {\n        padding: 0 !important;\n        margin-bottom: 12px;\n    }\n\n    .citeck-widget-contacts-comment_view-mode,\n    .citeck-widget-contacts-columns dl {\n        border-bottom: none !important;\n        padding: 5px 0 !important;\n    }\n\n    .citeck-widget-contacts-comment_view-mode dd,\n    .citeck-widget-contacts-columns dd {\n        color: #444444;\n        font-weight: 600;\n    }\n\n    .citeck-widget-contacts-comment_view-mode dt,\n    .citeck-widget-contacts-columns dt {\n        color: #B7B7B7;\n    }\n    .citeck-widget-contacts-comment_view-mode dt:after,\n    .citeck-widget-contacts-columns dt:after {\n        content: \":\";\n    }\n\n    /* Keep the platform's title chip (`.formio-form .card .card-title`) - with several contacts\n       in one widget it is the only thing separating one card from the next. Only the vertical\n       rhythm and the icon alignment are adjusted here. */\n    .citeck-widget-contacts .card .card-title {\n        margin-top: 2px;\n        margin-bottom: 12px !important;\n        margin-left: 0;\n        font-size: 14px !important;\n\n        display: flex;\n        gap: 3px;\n        align-items: center;\n    }\n</style>"
            },
